{
  "name": "explode",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "tools/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "bun run --cwd apps/quest dev",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && bun run --cwd apps/quest typecheck",
    "content:generate": "node tools/content/src/generate.ts",
    "content:check": "node tools/content/src/check.ts",
    "emulator:walkthrough": "node apps/quest/scripts/walkthrough.ts",
    "release:pages": "bunx gh-pages@6 -d apps/quest/dist --dotfiles -m \"Deploy $(git rev-parse --short HEAD)\"",
    "release:manifest": "node tools/release/src/cli.ts manifest",
    "release:verify": "node tools/release/src/cli.ts verify"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
