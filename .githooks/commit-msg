#!/bin/sh
# Enforce Conventional Commits: <type>(<optional scope>)!: <summary>
# Enabled by `git config core.hooksPath .githooks` (bun install does this via "prepare").
msg_file="$1"
subject=$(grep -v '^#' "$msg_file" | sed -n '/./{p;q;}')

# Let git's own generated messages through.
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='feat|fix|docs|chore|refactor|test|perf|style|build|ci|revert'
if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9._/-]+\))?!?: [^ ].*"; then
  echo "commit-msg: subject must follow Conventional Commits, e.g." >&2
  echo "  feat: turn the model with one hand" >&2
  echo "  fix(quest): unstick the ray pointer after an empty pinch" >&2
  echo "  docs: record the hosting decision" >&2
  echo "allowed types: $(echo $types | tr '|' ' ')" >&2
  echo "got: $subject" >&2
  exit 1
fi

if [ ${#subject} -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} chars; keep it to 72 or fewer." >&2
  exit 1
fi
