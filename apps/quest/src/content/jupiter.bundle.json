              ]
            },
            {
              "type": "show_annotation",
              "target_id": "part:metallic",
              "text": "Currents here are thought to make the field."
            }
          ],
          "hint": "Select the highlighted link, then press Unplug."
        },
        {
          "id": "step:jp-predict",
          "kind": "predict",
          "caption": "Before you look: point at the first part that loses what it needs.",
          "expect": {
            "type": "predict"
          },
          "on_enter": [
            {
              "type": "ask_prediction",
              "question": "Which part loses its source first?"
            }
          ],
          "hint": "Which part does a dynamo make?",
          "feedback": {
            "correct": "Right. With no dynamo there is no magnetic field, so nothing steers charged particles to the poles and the aurora fades.",
            "incorrect": "Not quite. The magnetic field loses its source first. Without it nothing steers charged particles to the poles, so the aurora fades."
          }
        },
        {
          "id": "step:jp-observe",
          "kind": "observe",
          "caption": "The field and the aurora are gone, but the storms keep turning: the weather runs on heat from below, not on the magnetic field. This is the teaching model's rule, not an observation of Jupiter.",
