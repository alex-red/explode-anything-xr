      "id": "lesson:jupiter-aurora",
      "system_id": "system:jupiter",
      "title": "Why do Jupiter's poles glow?",
      "objectives": [
        "Follow the chain from the metallic hydrogen ocean to the aurora.",
        "See that the magnetic field and the weather have different sources."
      ],
      "break_edge_id": "edge:powers:part:metallic->part:field",
