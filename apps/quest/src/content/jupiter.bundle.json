      "steps": [
        {
          "id": "step:jp-explode",
          "kind": "explode",
          "caption": "This is a simplified model of Jupiter. It is a teaching model: the layers are approximate, and nobody has seen the interior directly. Press Explode to open it up, or pinch with both hands and pull apart.",
          "expect": {
            "type": "explode_at_least",
            "factor": 0.8
          },
          "on_enter": [],
          "hint": "Press Explode. You can also pinch with both hands and pull them apart."
        },
        {
          "id": "step:jp-trace",
          "kind": "trace",
          "caption": "Press Trace to follow the electric currents from the metallic hydrogen ocean to the glowing poles.",
          "expect": {
            "type": "trace",
            "path_id": "path:dynamo-to-aurora"
          },
          "on_enter": [],
          "hint": "The Trace button is in the panel next to you."
        },
        {
          "id": "step:jp-unplug",
          "kind": "break",
          "caption": "Stop the dynamo: unplug the link between the metallic hydrogen ocean and the magnetic field.",
          "expect": {
            "type": "unplug",
            "edge_id": "edge:powers:part:metallic->part:field"
          },
          "on_enter": [
            {
              "type": "highlight",
